# Berries corpus configuration
#
# [exclude] entries subtract matching files from the Corpus.
# Matching is case-insensitive. A pattern without a path separator is matched
# against every path component. '*' and '?' are supported. A matching directory
# component excludes every file beneath it. A pattern containing '/' or '\\' is
# matched against a contiguous portion of the full path.
#
# Examples:
# .git
# bin
# obj
# *.tmp
# .git/objects

[exclude]
