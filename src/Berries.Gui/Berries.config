# Berries scan configuration
#
# [exclude] entries omit matching files beneath the selected Roots.
# Matching is case-insensitive. A pattern without a path separator is matched
# against every path component. '*' and '?' are supported. A pattern containing
# '/' or '\\' is matched against a contiguous portion of the full path. A trailing
# separator requires another path component after the match, so /obj/ means a
# directory named obj rather than a file named obj.
#
# Examples:
# /.git/
# /bin/
# /obj/
# *.tmp
# .git/objects

[exclude]
