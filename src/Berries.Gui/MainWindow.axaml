<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Berries.Gui"
        x:Class="Berries.Gui.MainWindow"
        Title="Berries"
        Width="1300"
        Height="850"
        MinWidth="900"
        MinHeight="600"
        KeyDown="MainWindow_KeyDown">
  <Grid RowDefinitions="Auto,*,Auto">
    <Menu x:Name="MainMenu" Grid.Row="0">
      <MenuItem Header="_File">
        <MenuItem Header="Select Roots..." Click="SelectRootsMenu_Click" />
        <MenuItem Header="-" />
        <MenuItem x:Name="LoadSessionMenu" Header="Load Saved Session..." IsEnabled="False" />
        <MenuItem x:Name="SaveSessionMenu" Header="Save Session..." IsEnabled="False" />
        <MenuItem Header="-" />
        <MenuItem x:Name="ExecuteMenu" Header="Execute..." Click="ExecuteMenu_Click" IsEnabled="False" />
        <MenuItem Header="-" />
        <MenuItem Header="Exit" Click="ExitMenu_Click" />
      </MenuItem>
    </Menu>

    <Grid Grid.Row="1">
      <Grid x:Name="RootsPanel" Margin="24" RowDefinitions="Auto,Auto,*">
        <StackPanel Spacing="5">
          <TextBlock Text="Search these directories for duplicates" FontSize="26" FontWeight="SemiBold" />
          <TextBlock Text="Add one or more disjoint directory trees." Opacity="0.65" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,8">
          <Button x:Name="AddRootButton" Content="Add..." Click="AddRootButton_Click" />
          <Button x:Name="RemoveRootButton" Content="Remove" Click="RemoveRootButton_Click" />
          <Button x:Name="ScanButton" Content="Explore" Click="ExploreButton_Click" />
        </StackPanel>
        <ListBox x:Name="RootsList" Grid.Row="2" />
      </Grid>

      <Grid x:Name="ExplorerPanel" IsVisible="False" RowDefinitions="Auto,*">
        <Border Padding="10,8" BorderThickness="0,0,0,1">
          <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,20,Auto,20,Auto,*" ColumnSpacing="7">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Button x:Name="BackButton" Content="Back" IsEnabled="False" />
              <Button x:Name="PivotButton" Content="Pivot ▾" Click="PivotButton_Click">
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem x:Name="PivotCorpusRootsMenu" Header="Roots" Click="PivotCorpusRoots_Click" IsEnabled="False" />
                    <MenuItem Header="-" />
                    <MenuItem x:Name="PivotContentMenu" Header="Group" Click="PivotContentOrAll_Click" IsEnabled="False" />
                    <MenuItem Header="Directory Namesakes" Click="PivotDirectoryNamesakes_Click" />
                    <MenuItem Header="Namesake Structure" Click="PivotDirectoryNamesakeStructure_Click" />
                    <MenuItem x:Name="PivotDirectoryMenu" Header="Containing Directory" Click="PivotDirectory_Click" IsEnabled="False" />
                    <MenuItem x:Name="PivotBranchMenu" Header="Branch" Click="PivotBranch_Click" IsEnabled="False" />
                    <MenuItem x:Name="PivotBestDirectoryPairMenu" Header="Best Directory Pair" Click="PivotBestDirectoryPair_Click" IsEnabled="False" />
                    <MenuItem x:Name="PivotBestBranchPairMenu" Header="Best Branch Pair" Click="PivotBestBranchPair_Click" IsEnabled="False" />
                    <MenuItem x:Name="PivotBranchPairMenu" Header="Current Suggested Branch Pair" Click="PivotSuggestedBranchPair_Click" IsEnabled="False" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <Button x:Name="ForwardButton" Content="Forward" IsEnabled="False" />
              <Button x:Name="SuggestButton" Content="Suggest" Click="Suggest_Click" IsEnabled="False" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7">
              <Button x:Name="InvertButton" Content="Invert ▾" IsEnabled="False">
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem x:Name="InvertSelectedCopiesMenu" Header="Invert Selected Copies  ⓘ" Click="InvertSelectedCopies_Click"
                              ToolTip.Tip="Invert the selection among identical copies of the selected files. Other Groups are unchanged." />
                    <MenuItem x:Name="InvertAllGroupsMenu" Header="Invert All Groups  ⓘ" Click="InvertAllGroups_Click"
                              ToolTip.Tip="Invert the selection of every file in every Group currently shown." />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <Button x:Name="ExcludeButton" Content="Exclude" Click="ExcludeImmediateButton_Click" IsEnabled="False" />
              <Button x:Name="DeleteButton" Content="Delete" Click="DeleteImmediateButton_Click" IsEnabled="False" />
              <Button x:Name="MoveRightButton" Content="Move →" Click="MoveRightImmediateButton_Click" IsEnabled="False" />
              <Button x:Name="MoveLeftButton" Content="← Move" Click="MoveLeftImmediateButton_Click" IsEnabled="False" />
            </StackPanel>

            <Button x:Name="UndoButton" Grid.Column="4" Content="Undo" Click="UndoImmediateButton_Click" IsEnabled="False" />

            <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="7" Margin="0,5,0,0">
              <TextBlock x:Name="SelectionText" Text="Selected: none" VerticalAlignment="Center" />
              <Button x:Name="ClearSelectionButton" Content="Clear" Click="ClearSelectionButton_Click" IsEnabled="False" Padding="7,2"
                      ToolTip.Tip="Clear selection (Esc)" />
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14" RowDefinitions="Auto,*">
          <StackPanel Margin="2,0,0,10" Spacing="4">
            <TextBlock x:Name="ProjectionTitle" FontSize="18" FontWeight="SemiBold" Text="Roots" />
            <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal" Spacing="4" IsVisible="False" />
          </StackPanel>

          <Grid x:Name="SingleExplorer" Grid.Row="1">
            <local:BerriesTreeView x:Name="ExplorerTree" SelectionMode="Multiple" SelectionChanged="ExplorerSelectionChanged" PointerPressed="ExplorerNode_PointerPressed">
              <TreeView.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </TreeView.ItemsPanel>
              <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="local:ExplorerNode" ItemsSource="{Binding Children}">
                  <TextBlock Text="{Binding Label}" ContextRequested="ExplorerNode_ContextRequested" />
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </local:BerriesTreeView>
          </Grid>

          <Grid x:Name="PairExplorer" Grid.Row="1" IsVisible="False" ColumnDefinitions="*,*" ColumnSpacing="14">
            <Grid RowDefinitions="Auto,*">
              <StackPanel x:Name="LeftScopeBreadcrumbs" Orientation="Horizontal" Spacing="4" Margin="2,0,0,8" />
              <local:BerriesTreeView x:Name="LeftTree" Grid.Row="1" SelectionMode="Multiple" SelectionChanged="ExplorerSelectionChanged" PointerPressed="ExplorerNode_PointerPressed">
                <TreeView.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </TreeView.ItemsPanel>
                <TreeView.ItemTemplate>
                  <TreeDataTemplate x:DataType="local:ExplorerNode" ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding Label}" ContextRequested="ExplorerNode_ContextRequested" />
                  </TreeDataTemplate>
                </TreeView.ItemTemplate>
              </local:BerriesTreeView>
            </Grid>
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
              <StackPanel x:Name="RightScopeBreadcrumbs" Orientation="Horizontal" Spacing="4" Margin="2,0,0,8" />
              <local:BerriesTreeView x:Name="RightTree" Grid.Row="1" SelectionMode="Multiple" SelectionChanged="ExplorerSelectionChanged" PointerPressed="ExplorerNode_PointerPressed">
                <TreeView.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </TreeView.ItemsPanel>
                <TreeView.ItemTemplate>
                  <TreeDataTemplate x:DataType="local:ExplorerNode" ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding Label}" ContextRequested="ExplorerNode_ContextRequested" />
                  </TreeDataTemplate>
                </TreeView.ItemTemplate>
              </local:BerriesTreeView>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Padding="10,6" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,260" ColumnSpacing="10">
        <TextBlock x:Name="StatusText" Text="Select roots to begin." VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <ProgressBar x:Name="StatusProgress" Grid.Column="1" Height="12" Minimum="0" Maximum="100" IsVisible="False" />
      </Grid>
    </Border>
  </Grid>
</Window>