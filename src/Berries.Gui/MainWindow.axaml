<Window xmlns="https://github.com/avaloniauI"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Berries.Gui.MainWindow"
        Title="Berries"
        Width="1300"
        Height="850"
        MinWidth="900"
        MinHeight="600"
        KeyDown="MainWindow_KeyDown">
  <Grid RowDefinitions="Auto,*,Auto">
    <Menu Grid.Row="0">
      <MenuItem Header="_File">
        <MenuItem Header="Select Roots..." Click="SelectRootsMenu_Click" />
        <MenuItem Header="-" />
        <MenuItem x:Name="LoadSessionMenu" Header="Load Saved Session..." IsEnabled="False" />
        <MenuItem x:Name="SaveSessionMenu" Header="Save Session..." IsEnabled="False" />
        <MenuItem Header="-" />
        <MenuItem x:Name="ExecuteMenu" Header="Execute..." Click="ExecuteMenu_Click" IsEnabled="False" />
        <MenuItem Header="-" />
        <MenuItem Header="Exit" Click="ExitMenu_Click" />
      </MenuItem>
    </Menu>

    <Grid Grid.Row="1">
      <Grid x:Name="RootsPanel" Margin="24" RowDefinitions="Auto,Auto,*">
        <StackPanel Spacing="5">
          <TextBlock Text="Search these directories for duplicates" FontSize="26" FontWeight="SemiBold" />
          <TextBlock Text="Add one or more disjoint directory trees." Opacity="0.65" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,8">
          <Button x:Name="AddRootButton" Content="Add..." Click="AddRootButton_Click" />
          <Button x:Name="RemoveRootButton" Content="Remove" Click="RemoveRootButton_Click" />
          <Button x:Name="ScanButton" Content="Explore" Click="ExploreButton_Click" />
        </StackPanel>
        <ListBox x:Name="RootsList" Grid.Row="2" />
      </Grid>

      <Grid x:Name="ExplorerPanel" IsVisible="False" RowDefinitions="Auto,*">
        <Border Padding="10,8" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="Auto,20,Auto,Auto,Auto,20,Auto,*" ColumnSpacing="7">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Button x:Name="BackButton" Content="Back" Click="BackButton_Click" IsEnabled="False" />
              <Button x:Name="PivotButton" Content="Pivot ▾" Click="PivotButton_Click">
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem x:Name="PivotContentMenu" Header="Group" Click="PivotContentOrAll_Click" IsEnabled="False" />
                    <MenuItem x:Name="PivotDirectoryMenu" Header="Containing Directory" Click="PivotDirectory_Click" IsEnabled="False" />
                    <MenuItem x:Name="PivotBranchMenu" Header="Branch" Click="PivotBranch_Click" IsEnabled="False" />
                    <MenuItem x:Name="PivotBestDirectoryPairMenu" Header="Best Directory Pair" Click="PivotBestDirectoryPair_Click" IsEnabled="False" />
                    <MenuItem x:Name="PivotBestBranchPairMenu" Header="Best Branch Pair" Click="PivotBestBranchPair_Click" IsEnabled="False" />
                    <MenuItem x:Name="PivotBranchPairMenu" Header="Current Suggested Branch Pair" Click="PivotBranchPair_Click" IsEnabled="False" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <Button x:Name="ForwardButton" Content="Forward" Click="ForwardButton_Click" IsEnabled="False" />
              <Button x:Name="SuggestCaseButton" Content="Suggest" Click="SuggestCaseButton_Click" IsEnabled="False" />
            </StackPanel>

            <Button x:Name="InvertButton" Grid.Column="2" Content="Invert Selection" Click="InvertButton_Click" IsEnabled="False" />
            <Button x:Name="ExcludeButton" Grid.Column="3" Content="Exclude" Click="ExcludeButton_Click" IsEnabled="False" />
            <Button x:Name="DeleteButton" Grid.Column="4" Content="Delete" Click="DeleteButton_Click" IsEnabled="False" />

            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="7">
              <Button x:Name="MoveRightButton" Content="Move →" Click="MoveRightButton_Click" IsEnabled="False" />
              <Button x:Name="MoveLeftButton" Content="← Move" Click="MoveLeftButton_Click" IsEnabled="False" />
              <Button x:Name="UndoButton" Content="Undo" Click="UndoButton_Click" IsEnabled="False" />
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14" RowDefinitions="Auto,*">
          <StackPanel Margin="2,0,0,10" Spacing="4">
            <TextBlock x:Name="ProjectionTitle" FontSize="18" FontWeight="SemiBold" Text="Corpus" />
            <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal" Spacing="4" IsVisible="False" />
          </StackPanel>

          <Grid x:Name="SingleExplorer" Grid.Row="1">
            <TreeView x:Name="ExplorerTree" SelectionMode="Multiple" SelectionChanged="ExplorerSelectionChanged" />
          </Grid>

          <Grid x:Name="PairExplorer" Grid.Row="1" IsVisible="False" ColumnDefinitions="*,*" ColumnSpacing="14">
            <Grid RowDefinitions="Auto,*">
              <TextBlock x:Name="LeftScopeText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,0,0,8" />
              <TreeView x:Name="LeftTree" Grid.Row="1" SelectionMode="Multiple" SelectionChanged="ExplorerSelectionChanged" />
            </Grid>
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
              <TextBlock x:Name="RightScopeText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,0,0,8" />
              <TreeView x:Name="RightTree" Grid.Row="1" SelectionMode="Multiple" SelectionChanged="ExplorerSelectionChanged" />
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Padding="10,6" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,260">
        <TextBlock x:Name="StatusText" Text="Select corpus roots to begin." VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <ProgressBar x:Name="StatusProgress" Grid.Column="1" Height="12" Minimum="0" Maximum="100" IsVisible="False" />
      </Grid>
    </Border>
  </Grid>
</Window>